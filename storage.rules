rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }
    function memberPath(orgId) {
      return /databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }
    function activeProfile(orgId) {
      return signedIn()
        && firestore.exists(userPath())
        && firestore.get(userPath()).data.status == 'active'
        && firestore.get(userPath()).data.organizationId == orgId;
    }
    function profileRequiresMembership() {
      return firestore.get(userPath()).data.keys().hasAny(['membershipEnforced'])
        && firestore.get(userPath()).data.membershipEnforced == true;
    }
    function activeMemberRecord(orgId) {
      return firestore.exists(memberPath(orgId))
        && firestore.get(memberPath(orgId)).data.status == 'active'
        && firestore.get(memberPath(orgId)).data.uid == request.auth.uid;
    }
    function memberOf(orgId) {
      return activeProfile(orgId)
        && (
          profileRequiresMembership()
            ? activeMemberRecord(orgId)
            : (!firestore.exists(memberPath(orgId)) || activeMemberRecord(orgId))
        );
    }
    function memberRole(orgId) {
      return (profileRequiresMembership() || firestore.exists(memberPath(orgId)))
        ? firestore.get(memberPath(orgId)).data.role
        : firestore.get(userPath()).data.role;
    }
    function canUpload(orgId) {
      return memberOf(orgId)
        && memberRole(orgId) in [
          'owner', 'admin', 'organizationOwner', 'organizationAdmin',
          'manager', 'broker', 'operations', 'claimsOfficer',
          'customerSupport', 'finance'
        ];
    }
    function canManageFiles(orgId) {
      return memberOf(orgId)
        && memberRole(orgId) in [
          'owner', 'admin', 'organizationOwner', 'organizationAdmin',
          'manager', 'operations'
        ];
    }
    function validUpload(orgId, documentId) {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|image/jpeg|image/png|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        )
        && request.resource.metadata.organizationId == orgId
        && request.resource.metadata.documentId == documentId
        && request.resource.metadata.uploaderId == request.auth.uid;
    }
    function fileUploader() {
      return resource.metadata.keys().hasAny(['uploaderId'])
        && resource.metadata.uploaderId == request.auth.uid;
    }

    match /organizations/{orgId}/documents/{documentId}/{fileName} {
      // All active organization members (including read-only viewers) may read.
      allow read: if memberOf(orgId);

      // Uploads are limited by membership, role, size, MIME type, and metadata.
      allow create: if canUpload(orgId) && validUpload(orgId, documentId);

      // Replacing an existing file requires being its uploader or a file manager.
      // Keep path and organization checks in force for every replacement.
      allow update: if canUpload(orgId)
        && (fileUploader() || canManageFiles(orgId))
        && validUpload(orgId, documentId)
        && (!resource.metadata.keys().hasAny(['organizationId'])
          || resource.metadata.organizationId == orgId)
        && (!resource.metadata.keys().hasAny(['documentId'])
          || resource.metadata.documentId == documentId);

      // Members may remove their own uploaded file; managers may administer files.
      allow delete: if memberOf(orgId)
        && (fileUploader() || canManageFiles(orgId));
    }

    function validOperationUpload(orgId, operationId) {
      return request.resource != null
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|text/csv|application/csv'
        )
        && request.resource.metadata.organizationId == orgId
        && request.resource.metadata.operationId == operationId
        && request.resource.metadata.uploaderId == request.auth.uid;
    }

    // Operations attachments use a different product workflow and a 20 MB
    // limit; this preserves its supported PDF/XLS/XLSX/CSV uploads.
    match /organizations/{orgId}/operations/{operationId}/{fileName} {
      allow read: if memberOf(orgId);
      allow create: if canUpload(orgId) && validOperationUpload(orgId, operationId);
      allow update: if canUpload(orgId)
        && (fileUploader() || canManageFiles(orgId))
        && validOperationUpload(orgId, operationId)
        && (!resource.metadata.keys().hasAny(['organizationId'])
          || resource.metadata.organizationId == orgId)
        && (!resource.metadata.keys().hasAny(['operationId'])
          || resource.metadata.operationId == operationId);
      allow delete: if memberOf(orgId)
        && (fileUploader() || canManageFiles(orgId));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
