# Firebase Web App configuration for project insurnex-8a9df.
# Copy this file to .env.production.local and replace every REPLACE_* value
# with the exact values from Firebase Console > Project settings > Your apps > Web app > Config.
# These are public client configuration values, not Admin SDK credentials.
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=insurnex-8a9df.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=insurnex-8a9df
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_EXACT_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_WEB_APP_ID

# Do not enable Firebase Emulator mode in a production Hosting build.
VITE_USE_FIREBASE_EMULATORS=false

# Supabase client configuration is separate. Populate only when a staging/production
# Supabase project is deliberately configured; never use a service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_DOCUMENT_STORAGE_PROVIDER=supabase
VITE_SUPABASE_DOCUMENT_BUCKET=insurnex-documents
