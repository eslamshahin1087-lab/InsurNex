# Dependencies and generated build output
node_modules/
dist/
dist-ssr/
coverage/

# Environment files (keep the documented template tracked)
.env
.env.*
!.env.example
*.local

# Firebase and Supabase local CLI state
.firebase/
supabase/.temp/

# Logs and transient editor files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.bak
*.swp
*.swo
*~

# Editor and operating-system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln

# Firebase Admin SDK credentials must never be committed
*firebase-adminsdk*.json

# Local-only audit and diagnostic output
/architecture-audit.txt
/architecture-audit.zip
/architecture.txt
/build-audit.txt
/git-audit.txt
/insurnex-ui-fix.zip
/operations-audit.txt
/project-state.txt
/project-tree.txt
/supabase-usage.txt

# Local reports may contain record identifiers, paths, or field-presence metadata
artifacts/legacy-storage-dry-run-*.json
artifacts/client-sensitive-data-inventory-*.json
artifacts/client-sensitive-data-separation-plan-*.json

# NOTE: functions/lib is intentionally tracked because functions/package.json
# declares lib/index.js as the deployed Firebase Functions entry point.
