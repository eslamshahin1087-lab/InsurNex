rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function organizationPath(orgId) { return /databases/$(database)/documents/organizations/$(orgId); }
    function memberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function me() { return get(userPath()).data; }
    function isMembershipEnforced() {
      return hasProfile()
        && me().keys().hasAny(['membershipEnforced'])
        && me().membershipEnforced == true;
    }
    function activeMembership(orgId) {
      return signedIn()
        && exists(memberPath(orgId))
        && get(memberPath(orgId)).data.uid == request.auth.uid
        && get(memberPath(orgId)).data.status == 'active';
    }
    function sameOrg(orgId) {
      return hasProfile()
        && me().status == 'active'
        && me().organizationId == orgId
        // Strict membership is enabled on new profiles and on migrated profiles.
        // Legacy profiles remain readable until their existing membership data
        // has been audited, avoiding an accidental lockout during rollout.
        && (
          exists(memberPath(orgId))
            ? (
              get(memberPath(orgId)).data.uid == request.auth.uid
              && get(memberPath(orgId)).data.status == 'active'
            )
            : !isMembershipEnforced()
        );
    }
    // New/migrated profiles use the active membership document as the role
    // authority. Untagged legacy profiles retain their protected existing role
    // until a controlled, non-destructive membership migration marks them strict.
    function roleIs(roles) {
      return hasProfile()
        && me().organizationId is string
        && (
          exists(memberPath(me().organizationId))
            ? (
              get(memberPath(me().organizationId)).data.uid == request.auth.uid
              && get(memberPath(me().organizationId)).data.status == 'active'
              && get(memberPath(me().organizationId)).data.role in roles
            )
            : (!isMembershipEnforced() && me().role in roles)
        );
    }
    function privileged() { return roleIs(['owner', 'admin', 'organizationOwner', 'organizationAdmin']); }
    function orgManager() { return roleIs(['owner', 'admin', 'organizationOwner', 'organizationAdmin', 'manager']); }
    function activeStaff() {
      return roleIs([
        'owner', 'admin', 'organizationOwner', 'organizationAdmin',
        'manager', 'broker', 'operations', 'claimsOfficer', 'customerSupport', 'finance'
      ]);
    }
    function ownsOrganizationAfterWrite(orgId) {
      return existsAfter(organizationPath(orgId))
        && getAfter(organizationPath(orgId)).data.ownerId == request.auth.uid;
    }

    function knownBusinessCollection(collectionName) {
      return collectionName in [
        'clients', 'leads', 'leadActivities', 'opportunities',
        'quotations', 'quotes', 'policies', 'claims', 'tasks',
        'calendar_events', 'documents', 'insurers', 'insurance_products',
        'products', 'payments', 'commissions', 'communications', 'messages',
        'notifications', 'activities', 'subscriptions', 'audit_logs', 'settings',
        'reports', 'teams', 'roles', 'permissions', 'organizationMembers',
        'relationships', 'operations', 'operationEvents', 'operationAttachments', 'rfqs',
        'clientActivities', 'policyActivities', 'claimActivities'
      ];
    }
    function genericBusinessCollection(collectionName) {
      return collectionName in [
        'clients', 'leads', 'tasks', 'calendar_events',
        'documents', 'communications', 'messages', 'notifications', 'relationships'
      ];
    }
    function restrictedCollection(collectionName) {
      return collectionName in [
        'users', 'organizations',
        'opportunities', 'quotations', 'quotes', 'policies', 'rfqs', 'claims',
        'payments', 'commissions', 'insurers', 'insurance_products', 'products',
        'subscriptions', 'audit_logs', 'settings', 'teams', 'roles', 'permissions',
        'organizationMembers', 'operations', 'operationEvents', 'operationAttachments'
      ];
    }
    function validCreator() {
      return (!request.resource.data.keys().hasAny(['createdBy'])
          || request.resource.data.createdBy == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['uploadedBy'])
          || request.resource.data.uploadedBy == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['createdByUid'])
          || request.resource.data.createdByUid == request.auth.uid);
    }
    function immutableCoreFields() {
      return request.resource.data.organizationId == resource.data.organizationId
        && (!resource.data.keys().hasAny(['createdBy'])
          || (request.resource.data.keys().hasAny(['createdBy'])
            && request.resource.data.createdBy == resource.data.createdBy))
        && (!resource.data.keys().hasAny(['createdAt'])
          || (request.resource.data.keys().hasAny(['createdAt'])
            && request.resource.data.createdAt == resource.data.createdAt))
        && (!resource.data.keys().hasAny(['uploadedBy'])
          || (request.resource.data.keys().hasAny(['uploadedBy'])
            && request.resource.data.uploadedBy == resource.data.uploadedBy))
        && (!resource.data.keys().hasAny(['ownerId'])
          || (request.resource.data.keys().hasAny(['ownerId'])
            && request.resource.data.ownerId == resource.data.ownerId))
        && (!resource.data.keys().hasAny(['storagePath'])
          || (request.resource.data.keys().hasAny(['storagePath'])
            && request.resource.data.storagePath == resource.data.storagePath))
        && (!resource.data.keys().hasAny(['storageProvider'])
          || (request.resource.data.keys().hasAny(['storageProvider'])
            && request.resource.data.storageProvider == resource.data.storageProvider))
        && (!resource.data.keys().hasAny(['storageBucket'])
          || (request.resource.data.keys().hasAny(['storageBucket'])
            && request.resource.data.storageBucket == resource.data.storageBucket))
        && (!resource.data.keys().hasAny(['contentType'])
          || (request.resource.data.keys().hasAny(['contentType'])
            && request.resource.data.contentType == resource.data.contentType))
        && (!resource.data.keys().hasAny(['size'])
          || (request.resource.data.keys().hasAny(['size'])
            && request.resource.data.size == resource.data.size))
        && (!resource.data.keys().hasAny(['operationId'])
          || (request.resource.data.keys().hasAny(['operationId'])
            && request.resource.data.operationId == resource.data.operationId));
    }
    function noPolicyFinancialChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'premium', 'commissionRate', 'commissionAmount', 'sumInsured',
        'basePremium', 'netPremium', 'taxAmount', 'totalPremium',
        'coverageAmount', 'brokerageCommission', 'brokerCommission',
        'grossPremium', 'discountAmount', 'feeAmount', 'insuredValue',
        'amount', 'currency', 'price', 'estimatedValue', 'insuredAmount'
      ]);
    }
    function noClaimSettlementChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'settlementAmount', 'approvedAmount', 'paidAmount', 'reserveAmount',
        'amountPaid', 'payoutAmount', 'reimbursedAmount', 'paymentAmount',
        'claimAmount', 'claimedAmount', 'requestedAmount', 'currency'
      ]);
    }
    function financeAllowedChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'paymentStatus', 'paidAt', 'paymentDate', 'reference',
        'notes', 'updatedAt', 'receiptDocumentId', 'transactionReference',
        'reconciledAt', 'reconciledBy', 'paymentMethod', 'invoiceNumber'
      ]);
    }
    function claimFinanceAllowedChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'settlementAmount', 'approvedAmount', 'paidAmount',
        'amountPaid', 'payoutAmount', 'reimbursedAmount', 'paymentAmount',
        'paymentStatus', 'paidAt', 'paymentDate', 'reference', 'notes',
        'updatedAt', 'receiptDocumentId', 'transactionReference'
      ]);
    }
    function quoteEditor() {
      return roleIs(['owner', 'admin', 'organizationOwner', 'organizationAdmin', 'manager', 'broker', 'operations']);
    }
    function claimEditor() {
      return roleIs(['owner', 'admin', 'organizationOwner', 'organizationAdmin', 'manager', 'broker', 'operations', 'claimsOfficer']);
    }
    function financeEditor() {
      return roleIs(['owner', 'admin', 'organizationOwner', 'organizationAdmin', 'finance']);
    }
    function catalogEditor() {
      return roleIs(['owner', 'admin', 'organizationOwner', 'organizationAdmin', 'manager']);
    }
    function operationEditor() {
      return roleIs(['owner', 'admin', 'organizationOwner', 'organizationAdmin', 'manager', 'broker', 'operations']);
    }
    function operationEventWriter() {
      return roleIs(['owner', 'admin', 'organizationOwner', 'organizationAdmin', 'manager', 'broker', 'operations', 'claimsOfficer']);
    }
    function adminDataEditor() {
      return roleIs(['owner', 'admin', 'organizationOwner', 'organizationAdmin']);
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (hasProfile() && resource.data.organizationId == me().organizationId && privileged())
      );
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'owner'
        && request.resource.data.status == 'active'
        && request.resource.data.organizationId is string
        && (
          !request.resource.data.keys().hasAny(['membershipEnforced'])
          || request.resource.data.membershipEnforced == true
        )
        && ownsOrganizationAfterWrite(request.resource.data.organizationId);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && (!resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt == resource.data.createdAt)
        && (
          (!resource.data.keys().hasAny(['membershipEnforced'])
            && !request.resource.data.keys().hasAny(['membershipEnforced']))
          || (resource.data.keys().hasAny(['membershipEnforced'])
            && request.resource.data.keys().hasAny(['membershipEnforced'])
            && request.resource.data.membershipEnforced == resource.data.membershipEnforced)
        );
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.type in ['individual', 'office', 'company'];
      allow read: if sameOrg(orgId);
      allow update: if sameOrg(orgId)
        && privileged()
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /members/{uid} {
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'owner'
          && request.resource.data.status == 'active'
          && getAfter(organizationPath(orgId)).data.ownerId == request.auth.uid;
        allow read: if sameOrg(orgId);
        allow update: if sameOrg(orgId)
          && privileged()
          && request.resource.data.uid == resource.data.uid;
        allow delete: if sameOrg(orgId) && privileged() && uid != request.auth.uid;
      }
    }

    // Role-specific matches isolate financial and workflow collections from
    // the generic business-record permissions.
    match /policies/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && quoteEditor();
      allow update: if sameOrg(resource.data.organizationId) && immutableCoreFields()
        && (privileged() || (quoteEditor() && noPolicyFinancialChanges()));
      allow delete: if false;
    }
    match /quotations/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && quoteEditor();
      allow update: if sameOrg(resource.data.organizationId) && immutableCoreFields()
        && (privileged() || (quoteEditor() && noPolicyFinancialChanges()));
      allow delete: if false;
    }
    match /quotes/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && quoteEditor();
      allow update: if sameOrg(resource.data.organizationId) && immutableCoreFields()
        && (privileged() || (quoteEditor() && noPolicyFinancialChanges()));
      allow delete: if false;
    }
    match /opportunities/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && quoteEditor();
      allow update: if sameOrg(resource.data.organizationId) && immutableCoreFields()
        && (privileged() || (quoteEditor() && noPolicyFinancialChanges()));
      allow delete: if false;
    }
    match /rfqs/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && quoteEditor();
      allow update: if sameOrg(resource.data.organizationId) && immutableCoreFields()
        && (privileged() || (quoteEditor() && noPolicyFinancialChanges()));
      allow delete: if false;
    }
    match /claims/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && claimEditor();
      allow update: if sameOrg(resource.data.organizationId) && immutableCoreFields()
        && (
          privileged()
          || (roleIs(['finance']) && claimFinanceAllowedChanges())
          || (roleIs(['manager', 'broker', 'operations', 'claimsOfficer']) && noClaimSettlementChanges())
        );
      allow delete: if false;
    }
    match /payments/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && financeEditor();
      allow update: if sameOrg(resource.data.organizationId) && immutableCoreFields()
        && (privileged() || (roleIs(['finance']) && financeAllowedChanges()));
      allow delete: if false;
    }
    match /commissions/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && financeEditor();
      allow update: if sameOrg(resource.data.organizationId) && immutableCoreFields()
        && (privileged() || (roleIs(['finance']) && financeAllowedChanges()));
      allow delete: if false;
    }
    match /insurers/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && catalogEditor();
      allow update: if sameOrg(resource.data.organizationId) && immutableCoreFields() && catalogEditor();
      allow delete: if false;
    }
    match /insurance_products/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && catalogEditor();
      allow update: if sameOrg(resource.data.organizationId) && immutableCoreFields() && catalogEditor();
      allow delete: if false;
    }
    match /products/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && catalogEditor();
      allow update: if sameOrg(resource.data.organizationId) && immutableCoreFields() && catalogEditor();
      allow delete: if false;
    }
    match /operations/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && operationEditor();
      allow update: if sameOrg(resource.data.organizationId) && immutableCoreFields()
        && roleIs(['owner', 'admin', 'organizationOwner', 'organizationAdmin', 'manager', 'operations']);
      allow delete: if false;
    }
    match /operationEvents/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && operationEventWriter();
      allow update, delete: if false;
    }
    match /operationAttachments/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && operationEditor();
      allow update, delete: if false;
    }
    match /subscriptions/{docId} {
      allow read: if sameOrg(resource.data.organizationId) && orgManager();
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && adminDataEditor();
      allow update: if sameOrg(resource.data.organizationId)
        && immutableCoreFields() && adminDataEditor();
      allow delete: if false;
    }
    match /audit_logs/{docId} {
      allow read: if sameOrg(resource.data.organizationId) && orgManager();
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && activeStaff();
      allow update, delete: if false;
    }
    match /settings/{docId} {
      allow read: if sameOrg(resource.data.organizationId) && orgManager();
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && adminDataEditor();
      allow update: if sameOrg(resource.data.organizationId)
        && immutableCoreFields() && adminDataEditor();
      allow delete: if false;
    }
    match /teams/{docId} {
      allow read: if sameOrg(resource.data.organizationId) && orgManager();
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && adminDataEditor();
      allow update: if sameOrg(resource.data.organizationId)
        && immutableCoreFields() && adminDataEditor();
      allow delete: if false;
    }
    match /roles/{docId} {
      allow read: if sameOrg(resource.data.organizationId) && orgManager();
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && adminDataEditor();
      allow update: if sameOrg(resource.data.organizationId)
        && immutableCoreFields() && adminDataEditor();
      allow delete: if false;
    }
    match /permissions/{docId} {
      allow read: if sameOrg(resource.data.organizationId) && orgManager();
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && adminDataEditor();
      allow update: if sameOrg(resource.data.organizationId)
        && immutableCoreFields() && adminDataEditor();
      allow delete: if false;
    }
    match /organizationMembers/{docId} {
      allow read: if sameOrg(resource.data.organizationId) && orgManager();
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && adminDataEditor();
      allow update: if sameOrg(resource.data.organizationId)
        && immutableCoreFields() && adminDataEditor();
      allow delete: if false;
    }

    // Activity/history records are append-only so users cannot rewrite audit trails.
    match /leadActivities/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && activeStaff();
      allow update, delete: if false;
    }
    match /activities/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && activeStaff();
      allow update, delete: if false;
    }
    match /clientActivities/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && activeStaff();
      allow update, delete: if false;
    }
    match /policyActivities/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && activeStaff();
      allow update, delete: if false;
    }
    match /claimActivities/{docId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && sameOrg(request.resource.data.organizationId) && validCreator() && activeStaff();
      allow update, delete: if false;
    }

    // These generic permissions deliberately exclude the collections above.
    // Firestore OR-combines matching rules, so no broad rule may re-open a
    // restricted collection after a stricter match rejects a request.
    match /{collectionName}/{docId} {
      allow read: if collectionName != 'users'
        && collectionName != 'organizations'
        && knownBusinessCollection(collectionName)
        && sameOrg(resource.data.organizationId)
        && (!(collectionName in [
          'subscriptions', 'audit_logs', 'settings', 'teams', 'roles', 'permissions', 'organizationMembers'
        ]) || orgManager());
      allow create: if genericBusinessCollection(collectionName)
        && sameOrg(request.resource.data.organizationId)
        && request.resource.data.organizationId is string
        && validCreator() && activeStaff();
      allow update: if genericBusinessCollection(collectionName)
        && sameOrg(resource.data.organizationId)
        && immutableCoreFields()
        && activeStaff();
      allow delete: if collectionName in [
          'clients', 'leads', 'tasks', 'calendar_events', 'communications', 'messages'
        ]
        && sameOrg(resource.data.organizationId)
        && roleIs(['owner', 'admin', 'organizationOwner', 'organizationAdmin', 'manager', 'broker'])
        || collectionName == 'documents'
          && sameOrg(resource.data.organizationId)
          && (
            privileged()
            || roleIs(['manager', 'operations'])
            || (resource.data.keys().hasAny(['uploadedBy']) && resource.data.uploadedBy == request.auth.uid)
          );
    }
  }
}
