// InsurNex production rules release marker: 2026-10-03-rules-v4
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAny(['platformRole'])
        && request.auth.token.platformRole in ['superAdmin', 'platformAdmin'];
    }

    function memberPath(orgId, userId) {
      return /databases/$(database)/documents/organizationMembers/$(orgId + '_' + userId);
    }

    function isMember(orgId) {
      return signedIn()
        && orgId is string
        && exists(memberPath(orgId, request.auth.uid))
        && get(memberPath(orgId, request.auth.uid)).data.status == 'active';
    }

    function hasOrgRole(orgId, roles) {
      return isMember(orgId)
        && get(memberPath(orgId, request.auth.uid)).data.role in roles;
    }

    function validOrgRole(role) {
      return role in [
        'organizationOwner',
        'organizationAdmin',
        'manager',
        'broker',
        'salesAgent',
        'customerService',
        'operations',
        'claimsOfficer',
        'finance',
        'viewer'
      ];
    }

    function ownerAssignableRole(role) {
      return role in [
        'organizationAdmin',
        'manager',
        'broker',
        'salesAgent',
        'customerService',
        'operations',
        'claimsOfficer',
        'finance',
        'viewer'
      ];
    }

    function adminAssignableRole(role) {
      return role in [
        'manager',
        'broker',
        'salesAgent',
        'customerService',
        'operations',
        'claimsOfficer',
        'finance',
        'viewer'
      ];
    }

    function managerAssignableRole(role) {
      return role in [
        'broker',
        'salesAgent',
        'customerService',
        'operations',
        'claimsOfficer',
        'finance',
        'viewer'
      ];
    }

    function validMemberStatus(status) {
      return status in ['active', 'invited', 'suspended'];
    }

    function createsInitialOwnerMember(orgId, memberId) {
      return signedIn()
        && memberId == orgId + '_' + request.auth.uid
        && request.resource.data.organizationId == orgId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'organizationOwner'
        && request.resource.data.status == 'active'
        && getAfter(
          /databases/$(database)/documents/organizations/$(orgId)
        ).data.ownerId == request.auth.uid;
    }

    function canCreateOrgMember(orgId, memberId) {
      return signedIn()
        && request.resource.data.organizationId == orgId
        && request.resource.data.userId is string
        && memberId == orgId + '_' + request.resource.data.userId
        && validMemberStatus(request.resource.data.status)
        && validOrgRole(request.resource.data.role)
        && (
          (
            hasOrgRole(orgId, ['organizationOwner'])
            && ownerAssignableRole(request.resource.data.role)
          )
          ||
          (
            hasOrgRole(orgId, ['organizationAdmin'])
            && adminAssignableRole(request.resource.data.role)
          )
          ||
          (
            hasOrgRole(orgId, ['manager'])
            && managerAssignableRole(request.resource.data.role)
          )
        );
    }

    function canUpdateOrgMember(orgId, memberId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return isPlatformAdmin()
        || (
          request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.userId == resource.data.userId
          && memberId == orgId + '_' + resource.data.userId
          && validMemberStatus(request.resource.data.status)
          && (
            (
              hasOrgRole(orgId, ['organizationOwner'])
              && (
                !changed.hasAny(['role'])
                || (
                  resource.data.role != 'organizationOwner'
                  && ownerAssignableRole(request.resource.data.role)
                )
              )
              && (
                resource.data.role != 'organizationOwner'
                || request.resource.data.status == 'active'
              )
            )
            ||
            (
              hasOrgRole(orgId, ['organizationAdmin'])
              && resource.data.role != 'organizationOwner'
              && resource.data.role != 'organizationAdmin'
              && (
                !changed.hasAny(['role'])
                || adminAssignableRole(request.resource.data.role)
              )
            )
            ||
            (
              hasOrgRole(orgId, ['manager'])
              && managerAssignableRole(resource.data.role)
              && managerAssignableRole(request.resource.data.role)
              && changed.hasOnly([
                'role',
                'status',
                'updatedAt',
                'teamId',
                'title',
                'department'
              ])
            )
          )
        );
    }

    function canDeleteOrgMember(orgId, memberId) {
      return isPlatformAdmin()
        || (
          memberId == orgId + '_' + resource.data.userId
          && resource.data.role != 'organizationOwner'
          && (
            hasOrgRole(orgId, ['organizationOwner'])
            ||
            (
              hasOrgRole(orgId, ['organizationAdmin'])
              && resource.data.role != 'organizationAdmin'
            )
          )
        );
    }

    function ownsPersonal(data) {
      return signedIn()
        && data.workspaceType == 'personal'
        && data.ownerId == request.auth.uid;
    }

    function readsWorkspace(data) {
      return isPlatformAdmin()
        || ownsPersonal(data)
        || (
          signedIn()
          && data.workspaceType == 'organization'
          && isMember(data.organizationId)
        );
    }

    function createsWorkspace(data, roles) {
      return signedIn()
        && (
          (
            data.workspaceType == 'personal'
            && data.ownerId == request.auth.uid
          )
          ||
          (
            data.workspaceType == 'organization'
            && data.organizationId is string
            && data.ownerId == request.auth.uid
            && hasOrgRole(data.organizationId, roles)
          )
        );
    }

    function canWriteExisting(data, roles) {
      return isPlatformAdmin()
        || (
          readsWorkspace(data)
          && request.resource.data.workspaceType == data.workspaceType
          && request.resource.data.organizationId == data.organizationId
          && request.resource.data.ownerId == data.ownerId
          && (
            ownsPersonal(data)
            || hasOrgRole(data.organizationId, roles)
          )
        );
    }

    function canDeleteExisting(data, roles) {
      return isPlatformAdmin()
        || (
          readsWorkspace(data)
          && (
            ownsPersonal(data)
            || hasOrgRole(data.organizationId, roles)
          )
        );
    }

    function canWriteNewUser() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.accountType in [
          'individual_broker',
          'brokerage_company',
          'brokerage_office',
          'broker_employee',
          'manager',
          'customer'
        ]
        && request.resource.data.roles is list
        && request.resource.data.roles.hasOnly([
          'organizationOwner',
          'broker',
          'manager',
          'customer'
        ])
        && !request.resource.data.keys().hasAny(['platformRole']);
    }

    match /users/{uid} {
      allow read: if isPlatformAdmin()
        || (signedIn() && uid == request.auth.uid);

      allow create: if canWriteNewUser();

      allow update: if isPlatformAdmin()
        || (
          signedIn()
          && uid == request.auth.uid
          && !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny([
              'roles',
              'platformRole',
              'accountType',
              'organizationId',
              'role',
              'permissions',
              'uid'
            ])
        );

      allow delete: if isPlatformAdmin();
    }

    match /organizations/{orgId} {
      allow read: if isPlatformAdmin() || isMember(orgId);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isPlatformAdmin()
        || (
          hasOrgRole(
            orgId,
            ['organizationOwner', 'organizationAdmin']
          )
          && request.resource.data.ownerId == resource.data.ownerId
        );

      allow delete: if isPlatformAdmin();
    }

    match /organizationMembers/{memberId} {
      allow read: if isPlatformAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        )
        || hasOrgRole(
          resource.data.organizationId,
          ['organizationOwner', 'organizationAdmin', 'manager']
        );

      allow create: if isPlatformAdmin()
        || createsInitialOwnerMember(
          request.resource.data.organizationId,
          memberId
        )
        || canCreateOrgMember(
          request.resource.data.organizationId,
          memberId
        );

      allow update: if canUpdateOrgMember(
        resource.data.organizationId,
        memberId
      );

      allow delete: if canDeleteOrgMember(
        resource.data.organizationId,
        memberId
      );
    }

    match /brokerProfiles/{uid} {
      allow read: if isPlatformAdmin()
        || (signedIn() && uid == request.auth.uid);

      allow create, update: if isPlatformAdmin()
        || (signedIn() && uid == request.auth.uid);

      allow delete: if isPlatformAdmin()
        || (signedIn() && uid == request.auth.uid);
    }

    match /notifications/{id} {
      allow read: if isPlatformAdmin()
        || (
          signedIn()
          && resource.data.recipientId == request.auth.uid
        );

      allow create: if isPlatformAdmin()
        || (
          signedIn()
          && request.resource.data.recipientId == request.auth.uid
        );

      allow update: if isPlatformAdmin()
        || (
          signedIn()
          && resource.data.recipientId == request.auth.uid
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(['read', 'readAt'])
        );

      allow delete: if isPlatformAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isPlatformAdmin();

      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && (
          request.resource.data.organizationId == null
          || isMember(request.resource.data.organizationId)
        );

      allow update, delete: if isPlatformAdmin();
    }

    match /knowledgeBase/{id} {
      allow read: if isPlatformAdmin()
        || resource.data.status == 'published';

      allow create, update, delete: if isPlatformAdmin();
    }

    match /announcements/{id} {
      allow read: if isPlatformAdmin()
        || resource.data.status == 'published';

      allow create, update, delete: if isPlatformAdmin();
    }

    match /insurers/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isPlatformAdmin();
    }

    match /insuranceProducts/{id} {
      allow read: if isPlatformAdmin()
        || resource.data.get('published', false) == true;

      allow create, update, delete: if isPlatformAdmin();
    }

    match /settings/{id} {
      allow read, write: if isPlatformAdmin();
    }

    match /reports/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'operations',
            'claimsOfficer',
            'finance'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'operations',
            'claimsOfficer',
            'finance'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'operations',
            'claimsOfficer',
            'finance'
          ]
        );
    }

    match /analytics/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create, update, delete: if isPlatformAdmin();
    }

    match /subscriptions/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || (
          request.resource.data.workspaceType == 'organization'
          && createsWorkspace(
            request.resource.data,
            [
              'organizationOwner',
              'organizationAdmin',
              'manager'
            ]
          )
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager'
          ]
        );
    }

    match /invoices/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'finance'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'finance'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'finance'
          ]
        );
    }

    match /supportTickets/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService',
            'operations',
            'viewer'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'customerService',
            'operations'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'customerService',
            'operations'
          ]
        );
    }

    match /documents/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService',
            'operations',
            'claimsOfficer',
            'finance'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService',
            'operations',
            'claimsOfficer',
            'finance'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService',
            'operations',
            'claimsOfficer',
            'finance'
          ]
        );
    }

    match /clients/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService'
          ]
        );
    }

    match /leads/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent'
          ]
        );
    }

    match /policies/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'operations'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'operations'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'operations'
          ]
        );
    }

    match /quotes/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent'
          ]
        );
    }

    match /renewals/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'operations'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'operations'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'operations'
          ]
        );
    }

    match /claims/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'claimsOfficer',
            'operations'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'claimsOfficer',
            'operations'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'claimsOfficer',
            'operations'
          ]
        );
    }

    match /payments/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'finance'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'finance'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'finance'
          ]
        );
    }

    match /tasks/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService',
            'operations',
            'claimsOfficer',
            'finance'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService',
            'operations',
            'claimsOfficer',
            'finance'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService',
            'operations',
            'claimsOfficer',
            'finance'
          ]
        );
    }

    match /appointments/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService'
          ]
        );
    }

    match /activities/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if signedIn()
        && (
          isPlatformAdmin()
          || ownsPersonal(request.resource.data)
          || hasOrgRole(
            request.resource.data.organizationId,
            [
              'organizationOwner',
              'organizationAdmin',
              'manager',
              'broker',
              'salesAgent',
              'customerService',
              'operations',
              'claimsOfficer',
              'finance'
            ]
          )
        );

      allow update, delete: if isPlatformAdmin();
    }

    match /notes/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService',
            'operations',
            'claimsOfficer',
            'finance'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService',
            'operations',
            'claimsOfficer',
            'finance'
          ]
        );

      allow delete: if isPlatformAdmin()
        || canDeleteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService',
            'operations',
            'claimsOfficer',
            'finance'
          ]
        );
    }

    match /messages/{id} {
      allow read: if isPlatformAdmin()
        || readsWorkspace(resource.data);

      allow create: if isPlatformAdmin()
        || createsWorkspace(
          request.resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService'
          ]
        );

      allow update: if isPlatformAdmin()
        || canWriteExisting(
          resource.data,
          [
            'organizationOwner',
            'organizationAdmin',
            'manager',
            'broker',
            'salesAgent',
            'customerService'
          ]
        );

      allow delete: if isPlatformAdmin()
